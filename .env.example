# Environment Configuration
NODE_ENV=development

# Mock Services (set to true to use mock data instead of real APIs)
USE_MOCKS=true

# Database (Supabase / PostgreSQL)
DATABASE_URL=postgresql://username:password@host:5432/postgres?sslmode=require
DIRECT_URL=postgresql://username:password@host:5432/postgres?sslmode=require

# Upstash Redis
UPSTASH_REDIS_URL=https://your-upstash-redis-url
UPSTASH_REDIS_TOKEN=your-upstash-redis-token

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-your-key-here

# JWT
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long

# Frontend URL (for CORS)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Cron Job Secret
CRON_SECRET=your-cron-secret-key

# Report Storage
REPORTS_DIR=./reports

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your@email.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=SEO Dashboard <noreply@seodashboard.com>

FRONTEND_URL=http://localhost:3000
