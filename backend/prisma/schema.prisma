// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  CLIENT
}

enum AuditStatus {
  WAITING
  ACTIVE
  COMPLETED
  FAILED
  DELAYED
}

enum NotificationType {
  AUDIT_STARTED
  AUDIT_COMPLETED
  AUDIT_FAILED
  PDF_GENERATED
  REPORT_DELIVERED
  REPORT_DELIVERY_FAILED
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  password         String
  name             String
  role             Role      @default(CLIENT)
  resetToken       String?   @unique
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  client       Client?
  notifications Notification[]

  @@index([email])
  @@index([role])
  @@index([resetToken])
}

model Client {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  phone       String?
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  websites    Website[]
  notifications Notification[]

  @@index([userId])
}

model Website {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  url          String
  name         String
  businessType String   @default("general")
  city         String?
  state        String?
  targetKeywords String[]
  isActive     Boolean  @default(true)
  lastAuditAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  audits       Audit[]

  @@index([clientId])
  @@index([url])
}

model Audit {
  id           String      @id @default(cuid())
  websiteId    String
  website      Website     @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  status       AuditStatus @default(WAITING)
  progress     Int         @default(0)
  jobId        String?     @unique
  triggeredBy  String      @default("manual")
  startedAt    DateTime?
  completedAt  DateTime?
  failedAt     DateTime?
  errorMessage String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  result       AuditResult?
  report       Report?
  notifications Notification[]

  @@index([websiteId])
  @@index([status])
  @@index([createdAt])
}

model AuditResult {
  id              String   @id @default(cuid())
  auditId         String   @unique
  audit           Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)

  overallScore    Int      @default(0)
  technicalScore  Int      @default(0)
  onPageScore     Int      @default(0)
  contentScore    Int      @default(0)
  cwvScore        Int      @default(0)
  schemaScore     Int      @default(0)

  criticalIssues  Json     @default("[]")
  importantIssues Json     @default("[]")
  quickWins       Json     @default("[]")
  recommendations Json     @default("[]")
  executiveSummary String  @default("")

  crawlData       Json?
  pageSpeedData   Json?
  gscData         Json?
  schemaData      Json?
  technicalData   Json?
  rankingsData    Json?

  rawAiResponse   Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([auditId])
}

model Report {
  id          String   @id @default(cuid())
  auditId     String   @unique
  audit       Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  filePath    String
  fileName    String
  fileSize    Int?
  generatedAt DateTime @default(now())

  deliveries  ReportDelivery[]

  @@index([auditId])
}

model ReportDelivery {
  id         String   @id @default(cuid())
  reportId   String
  report     Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  channel    String   // 'whatsapp' | 'email'
  status     String   // 'sent' | 'failed' | 'mock_sent'
  sid        String?
  error      String?
  deliveredAt DateTime @default(now())

  @@index([reportId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  clientId  String?
  client    Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  auditId   String?
  audit     Audit?           @relation(fields: [auditId], references: [id], onDelete: SetNull)
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([clientId])
  @@index([isRead])
  @@index([createdAt])
}
